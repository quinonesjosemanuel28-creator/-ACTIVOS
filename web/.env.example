# Copiá este archivo a .env.local y completá los valores.

# URL pública del sitio — usada en canonical, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.activosacademy.com

# Endpoint del formulario de contacto (Formspree).
# Creá un form gratis en https://formspree.io y pegá tu endpoint completo.
# Ej: https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
