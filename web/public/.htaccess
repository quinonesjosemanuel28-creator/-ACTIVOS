# Configuración para hosting Apache (Hostinger).
AddDefaultCharset UTF-8

# MIME correcto para fuentes web.
AddType font/woff2 .woff2
AddType font/woff .woff

# Next exporta las imágenes de metadata sin extensión: forzamos su tipo.
<Files "opengraph-image">
  ForceType image/png
</Files>
<Files "apple-icon">
  ForceType image/png
</Files>

# Cache: assets con hash de Next (inmutables) por 1 año; HTML sin cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
