# Asistente IA — copiá este archivo a .env y completá tu API key.
#   cp .env.example .env
# La API key de Anthropic NO se versiona (.env está en .gitignore).

# Tu clave de la API de Anthropic (https://console.anthropic.com/ → API Keys)
ANTHROPIC_API_KEY=

# Modelo a usar (opcional). Por defecto: claude-haiku-4-5 (rápido y barato).
# Para más potencia: claude-sonnet-4-6 o claude-opus-4-8
ASISTENTE_MODELO=claude-haiku-4-5

# ── Login (multi-usuario) ─────────────────────────────────────────────────
# ADMIN inicial: se crea UNA sola vez si la base no tiene usuarios.
# Después de entrar, cambiá la contraseña desde la app.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Base de datos ─────────────────────────────────────────────────────────
# Driver: "sqlite" (default, archivo local data/activos.db) o "postgres".
DB_DRIVER=sqlite

# Solo si DB_DRIVER=postgres: URL de conexión (local o Railway).
# Local Mac (Homebrew):  postgresql://activos_app:TU_CLAVE@localhost:5432/activos
# DATABASE_URL=

# TLS hacia Postgres. Local: no hace falta (default off). Railway desde tu
# Mac (URL pública del proxy): PGSSL=true. En el servicio de Railway (red
# interna) tampoco hace falta.
# PGSSL=true

# ── Producción (Railway las define en su panel, NO en este archivo) ───────
# NODE_ENV=production   → sirve dist/ + cookie Secure (lo setea npm start)
# PORT                  → lo inyecta Railway automáticamente
