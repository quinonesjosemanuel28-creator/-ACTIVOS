# Asistente IA — copiá este archivo a .env y completá tu API key.
#   cp .env.example .env
# La API key de Anthropic NO se versiona (.env está en .gitignore).

# Tu clave de la API de Anthropic (https://console.anthropic.com/ → API Keys)
ANTHROPIC_API_KEY=

# Modelo a usar (opcional). Por defecto: claude-haiku-4-5 (rápido y barato).
# Para más potencia: claude-sonnet-4-6 o claude-opus-4-8
ASISTENTE_MODELO=claude-haiku-4-5

# ── Base de datos ─────────────────────────────────────────────────────────
# Driver: "sqlite" (default, archivo local data/activos.db) o "postgres".
DB_DRIVER=sqlite

# Solo si DB_DRIVER=postgres: URL de conexión (local o Railway).
# Local Mac (Homebrew):  postgresql://activos_app:TU_CLAVE@localhost:5432/activos
# DATABASE_URL=
